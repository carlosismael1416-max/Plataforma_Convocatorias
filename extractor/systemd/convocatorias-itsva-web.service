[Unit]
Description=Web de convocatorias ITSVA (Laravel, 127.0.0.1:8000)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=carlos_ismael
Group=carlos_ismael
WorkingDirectory=/home/carlos_ismael/proyectos/convocatorias-itsva/web
ExecStart=/usr/bin/php artisan serve --host=127.0.0.1 --port=8000
Environment=PHP_CLI_SERVER_WORKERS=4
Restart=on-failure
RestartSec=5
MemoryMax=512M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
