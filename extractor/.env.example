# ============================================================
# BASE DE DATOS POSTGRESQL
# ============================================================

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nombre_base_datos
DB_USERNAME=usuario_postgresql
DB_PASSWORD=contraseña_postgresql


# ============================================================
# BOT / SCRAPING
# ============================================================

APP_ENV=local
APP_DEBUG=true

SCRAPER_USER_AGENT=ITSVA-Convocatorias-Bot/1.0
REQUEST_TIMEOUT=30
DOWNLOAD_DELAY=1


# ============================================================
# DIRECTORIOS
# ============================================================

DATA_DIR=data
EXTRACTED_DIR=data/extraidos
DOWNLOAD_DIR=data/descargas
LOG_DIR=logs
