# ------------------------------------------------------------

extractor/*.log
extractor/*.tmp

extractor/detalle_resultado.json
extractor/detalle_proyecto.html

extractor/data/extraidos/*.json
extractor/data/temporales/


# ------------------------------------------------------------
# LOGS
