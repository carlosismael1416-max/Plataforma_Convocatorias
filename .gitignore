# ------------------------------------------------------------
# VARIABLES DE ENTORNO / CREDENCIALES
# ------------------------------------------------------------

.env
.env.*
!.env.example

web/.env
web/.env.*
!web/.env.example

extractor/.env
extractor/.env.*
!extractor/.env.example


# ------------------------------------------------------------
# LARAVEL / PHP
# ------------------------------------------------------------

web/vendor/
web/node_modules/

web/public/build/
web/public/hot
web/public/storage

web/storage/*.key
web/storage/logs/*.log
web/storage/framework/cache/*
web/storage/framework/sessions/*
web/storage/framework/views/*

web/bootstrap/cache/*.php

web/.phpunit.cache/
web/.phpunit.result.cache

web/auth.json


# ------------------------------------------------------------
# PYTHON
# ------------------------------------------------------------

extractor/.venv/
extractor/venv/
extractor/env/

__pycache__/
*.py[cod]
*$py.class

*.so

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

*.egg-info/
dist/
build/


